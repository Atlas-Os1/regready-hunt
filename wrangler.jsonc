{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "regready-hunt",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./projects/regready-hunt",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "regready-hunt-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "RULES_STATUS": "demo-data"
      },
      "d1_databases": [
        {
          "binding": "RULES_DB",
          "database_name": "regready-hunt-rules-preview",
          "database_id": "298875a7-d758-4e8a-b0d6-96aff6666180",
          "migrations_dir": "./migrations"
        }
      ]
    },
    "production": {
      "name": "regready-hunt-production",
      "vars": {
        "ENVIRONMENT": "production",
        "RULES_STATUS": "demo-data"
      },
      "d1_databases": [
        {
          "binding": "RULES_DB",
          "database_name": "regready-hunt-rules-production",
          "database_id": "a7edad20-4403-40dc-8df0-e5f4fdd03286",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
